{
  "name": "@habemus-papadum/cf-creds-zarr",
  "version": "0.4.0+dev",
  "description": "Signed range reads for zarr-over-S3: a ranged Reader over signed fetch for zip stores and friends",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/cf_browser_credentials.git",
