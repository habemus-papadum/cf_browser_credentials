{
  "name": "@habemus-papadum/cf-creds-aws",
  "version": "0.2.0",
  "description": "Signed fetch for browsers holding ephemeral AWS credentials: SigV4 via aws4fetch, client cached per credential session",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/cf_browser_credentials.git",
    "directory": "packages/cf-creds-aws"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/cf-browser-credentials": "workspace:^",
    "aws4fetch": "^1.0.20"
  }
}
