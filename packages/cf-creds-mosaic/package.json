{
  "name": "@habemus-papadum/cf-creds-mosaic",
  "version": "0.8.1+dev",
  "description": "Credential-aware Mosaic connector: install rotating S3 credentials into DuckDB-Wasm at the query boundary",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/cf_browser_credentials.git",
    "directory": "packages/cf-creds-mosaic"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@habemus-papadum/cf-browser-credentials": "workspace:*",
    "@habemus-papadum/cf-creds-aws": "workspace:*",
    "@uwdata/mosaic-core": "^0.29.2"
  },
  "peerDependencies": {
    "@habemus-papadum/cf-browser-credentials": "workspace:>=0.8.0",
    "@habemus-papadum/cf-creds-aws": "workspace:>=0.8.0",
    "@uwdata/mosaic-core": ">=0.28 <0.31"
  },
  "peerDependenciesMeta": {
    "@uwdata/mosaic-core": {
      "optional": true
    }
  }
}
