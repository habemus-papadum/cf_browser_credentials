{
  "name": "@habemus-papadum/cf-creds-elevenlabs",
  "version": "0.3.0",
  "description": "ElevenLabs single-use realtime tokens: worker-side mint from a parent key, browser-side fetch-per-connect helpers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/cf_browser_credentials.git",
    "directory": "packages/cf-creds-elevenlabs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/cf-browser-credentials": "workspace:^"
  }
}
