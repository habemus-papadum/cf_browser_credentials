{
  "name": "@habemus-papadum/cf-creds-openai",
  "version": "0.8.1+dev",
  "description": "Keyless OpenAI in the browser: a credentials service's own OIDC token, exchanged by the OpenAI SDK's workload identity federation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/cf_browser_credentials.git",
    "directory": "packages/cf-creds-openai"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@habemus-papadum/cf-browser-credentials": "workspace:*",
    "openai": "^7.4.0"
  },
  "peerDependencies": {
    "@habemus-papadum/cf-browser-credentials": "workspace:>=0.8.0",
    "openai": "^7.4.0"
  }
}
